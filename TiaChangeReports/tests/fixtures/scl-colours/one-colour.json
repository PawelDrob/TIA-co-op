/tr><tr><td class=\"ln\">112</td><td>                #tmpI := #tmpI + 1;</td></tr><tr><td class=\"ln\">113</td><td>            END_WHILE;</td></tr><tr><td class=\"ln\">114</td><td>        </td></tr><tr><td class=\"ln\">115</td><td>            REPEAT</td></tr><tr><td class=\"ln\">116</td><td>                #tmpI := #tmpI - 1;</td></tr><tr><td class=\"ln\">117</td><td>            UNTIL #tmpI &lt;= 0 OR #statFlag XOR #tmpBit</td></tr><tr><td class=\"ln\">118</td><td>            END_REPEAT;</td></tr><tr><td class=\"ln\">119</td><td>        END_REGION</td></tr><tr><td class=\"ln\">120</td><td>        </td></tr><tr><td class=\"ln\">121</td><td>        REGION Calls</td></tr><tr><td class=\"ln\">122</td><td>            // An instruction with an instance and without, an FC, an FB as a multi-instance and with its DB</td></tr><tr><td class=\"ln\">123</td><td>            #instDelay(IN := #inEnable,</td></tr><tr><td class=\"ln\">124</td><td>                       PT := T#5s,</td></tr><tr><td class=\"ln\">125</td><td>                       Q =&gt; #statFlag,</td></tr><tr><td class=\"ln\">126</td><td>                       ET =&gt; #statTime);</td></tr><tr><td class=\"ln\">127</td><td>            #statResult := MAX(IN1 := #statResult, IN2 := 10);</td></tr><tr><td class=\"ln\">128</td><td>            #statReal := SQRT(ABS(#inSetpoint)) ** 2.0;</td></tr><tr><td class=\"ln\">129</td><td>            #statResult := &quot;zzBenSclColFc&quot;(inA := #statResult, inB := 5);</td></tr><tr><td class=\"ln\">130</td><td>            #instColFb(inStart := #statFlag,</td></tr><tr><td class=\"ln\">131</td><td>                       outDone =&gt; #tmpBit);</td></tr><tr><td class=\"ln\">132</td><td>            &quot;zzBenSclColFbDb&quot;(inStart := #inEnable);</td></tr><tr><td class=\"ln\">133</td><td>            #outCount := INT_TO_DINT(#statResult) * 2 - #tmpSum / 3;</td></tr><tr><td class=\"ln\">134</td><td>        END_REGION</td></tr><tr><td class=\"ln\">135</td><td>        </td></tr><tr><td cl